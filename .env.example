# Use credentials from your own Supabase project; no Marketplace database is required.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Legacy alternative: set NEXT_PUBLIC_SUPABASE_ANON_KEY instead of the publishable key.
# Never put a service-role or secret key in a NEXT_PUBLIC_ variable.
# Authentication is disabled until the URL and a public key are configured.
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL is supplied by v0 for preview callbacks.
# Hosted Supabase Auth must have email confirmation enabled, OTP length 8,
# and a Confirm signup email template containing {{ .Token }}.
